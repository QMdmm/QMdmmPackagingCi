#!/bin/bash
# archroot —— Arch 虚拟根入口（proot，全程零 root；一个 rootfs 一个 wrapper）
#   archroot            伪 root shell（id=0，可跑 pacman）
#   archroot <cmd...>   伪 root 跑单条命令
#   archroot -u <cmd..> 真实 uid(1001) —— makepkg 拒绝以 root 运行，构建走这个
# 伪 root 用 -S（自动绑宿主 /etc /tmp $HOME——装包够用且 HOME=/root 屏蔽宿主劫持）；
# -u 模式必须手工绑定：proot 的推荐绑定会把宿主 Debian 的 /etc 盖进来，
# makepkg 会读到宿主的 /etc 而不是 guest 的 makepkg.conf。只绑 /dev /proc /sys + 构建目录。
export LD_LIBRARY_PATH="$HOME/.local/proot/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export PROOT_NO_SECCOMP=1
P="$HOME/.local/proot/usr/bin/proot"
A="$HOME/arch-rootfs"
if [ "${1:-}" = "-u" ]; then
  shift
  BINDS=(-b /dev -b /proc -b /sys)
  [ -d "$HOME/arch-build" ] && BINDS+=(-b "$HOME/arch-build")
  if [ $# -eq 0 ]; then
    exec "$P" -r "$A" "${BINDS[@]}" env HOME=/home/neve TERM="$TERM" /bin/bash -l
  fi
  exec "$P" -r "$A" "${BINDS[@]}" env HOME=/home/neve "$@"
fi
if [ $# -eq 0 ]; then
  exec "$P" --kill-on-exit -S "$A" env HOME=/root TERM="$TERM" /bin/bash -l
fi
exec "$P" --kill-on-exit -S "$A" env HOME=/root "$@"
