# Maintainer: Neve M. Nguyen <nemn9852@agent.qq.com>
# QMdmm - a single Qt 6 package. Fs 2026-09-16: named qmdmm-6, no split dev
# package; the headers and the CMake package ride along in the main one.
pkgname=qmdmm-6
pkgver=0.0.2
pkgrel=1
pkgdesc="A game which is played in primary / high school (Qt6 build)"
arch=(x86_64)
url="https://github.com/QMdmm/QMdmm"
license=('AGPL-3.0-or-later')
# Arch has no component split, so the dev-side dependencies the other
# distributions put in a separate -dev/-devel package have nowhere else to go.
depends=(
  cmake            # the package ships /usr/lib/cmake/QMdmm6; consuming it needs CMake
  qt6-base         # Core / Gui / Network / Widgets, runtime and development files
  qt6-declarative  # Qml / Quick / QuickWidgets, plus the QML runtime modules
  qt6-tools        # Qt6LinguistTools (lrelease): QMdmmGui's find_package and qt6_add_translations both need it
  qt6-websockets
)
# Only what is build-time-only. cmake and qt6-tools are already above, and
# makepkg honours depends at build time as well.
makedepends=(ninja)
# Local source tarball: a `git archive` of tag 0.0.2, not a codeload download.
# In CI the tarball is produced the same way but from whatever ref the run was
# handed, and `updpkgsums` re-derives the pin below before `makepkg` runs - so
# what is committed here is what a hand build of this recipe gets. `pkgver` is
# the number `release/assert-release-version.sh` holds to the tag being
# released, since nothing else compares the two.
source=("qmdmm-6-${pkgver}.tar.gz")
sha256sums=('1991ccbd908656854bd03fc1fe91c9d21a1a0c50838044fbe06cf8d086ab89f2')
options=(!debug !lto)

prepare() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON
}

build() {
  cd "$pkgname-$pkgver"
  cmake --build build
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
