# Maintainer: Neve M. Nguyen <nemn9852@agent.qq.com>
pkgname=qmdmm
pkgver=0.0.1
pkgrel=0
pkgdesc="A game which is played in primary / high school"
url="https://github.com/Fsu0413/QMdmm"
arch="all"
license="AGPL-3.0-only"
depends="qt6-qtbase qt6-qtdeclarative qt6-qtwebsockets"
makedepends="
	cmake
	doxygen
	gettext
	graphviz
	linux-headers
	make
	gcc
	musl-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qttools-dev
	qt6-qtwebsockets-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="qmdmm-$pkgver.tar.gz"
options="!check !debug"

build() {
	# Alpine's cmake defaults to Ninja, but its ninja-build package ships
	# /usr/lib/ninja-build/bin/ninja, off PATH -> pin Makefiles.
	cmake -B build \
		-G "Unix Makefiles" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_TESTING=OFF
	cmake --build build -j "$(nproc)"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

