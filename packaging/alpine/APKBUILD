# Maintainer: Neve M. Nguyen <nemn9852@agent.qq.com>
pkgname=qmdmm
pkgver=0.0.2
pkgrel=0
pkgdesc="A game which is played in primary / high school"
url="https://github.com/QMdmm/QMdmm"
arch="all"
license="AGPL-3.0-only"
depends="qt6-qtbase qt6-qtdeclarative qt6-qtwebsockets"
# What a consumer needs in order to build against the installed package. The
# deb and rpm dev components declare the same set (CPACK_DEBIAN_DEV6_PACKAGE_DEPENDS
# / CPACK_RPM_DEV6_PACKAGE_REQUIRES in QMdmm's root CMakeLists); without it
# `qmdmm-dev` brings in the runtime libraries and nothing to compile or configure
# against, and find_package(Qt6) fails before QMdmm is ever reached. The runtime
# package itself is added to -dev automatically, version-locked.
depends_dev="
	cmake
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtwebsockets-dev
	qt6-qttools-dev
	"
makedepends="
	cmake
	doxygen
	gettext
	graphviz
	linux-headers
	make
	gcc
	musl-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qttools-dev
	qt6-qtwebsockets-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="qmdmm-$pkgver.tar.gz"
options="!check !debug"

build() {
	# Alpine's cmake defaults to Ninja, but its ninja-build package ships
	# /usr/lib/ninja-build/bin/ninja, off PATH -> pin Makefiles.
	cmake -B build \
		-G "Unix Makefiles" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_TESTING=OFF
	cmake --build build -j "$(nproc)"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
